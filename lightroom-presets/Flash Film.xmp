   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Direct-flash colour-negative look: matte grey-cream whites, deep blacks, muted palette with hot pink pops, natural skin, fine grain. Use with Camera PRO Neg. Std.</rdf:li>
    </rdf:Alt>

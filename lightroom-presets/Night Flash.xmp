    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Night on-camera flash look: cool navy blacks, warm rosy flash-lit skin, rich orange city lights, pastel cools, matte highlights, fine grain. Use with Camera CLASSIC Neg.</rdf:li>
    </rdf:Alt>
   </crs:Description>

   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Night Flash</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default"/>
    </rdf:Alt>
